{
  "name": "@repo/website",
  "version": "0.0.1",
  "private": true,
  "description": "Sitio web público de Nexova (Hito 1): HTML estático + Tailwind CSS",
  "scripts": {
    "start": "npx -y serve@14.2.6 . -l 3000 --no-clipboard",
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/tailwind.css --minify",
    "dev:css": "tailwindcss -i ./src/input.css -o ./assets/tailwind.css --watch",
    "test": "node --test tests/validation.test.js",
    "check:classes": "node scripts/check-classes.js",
    "check": "npm run build:css && npm test && npm run check:classes"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
